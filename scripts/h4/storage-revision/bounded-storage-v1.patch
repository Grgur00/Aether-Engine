+package io.aetherdb.engine;
+
+import io.aetherdb.api.AetherDatabase;
+import io.aetherdb.config.AetherConfiguration;
+import io.aetherdb.lsm.iterator.InternalIterator;
+import io.aetherdb.sstable.InternalKey;
+import io.aetherdb.sstable.SSTableBuilder;
+import io.aetherdb.sstable.SSTableReader;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import static org.assertj.core.api.Assertions.*;
+
+class H4StreamingStorageTest {
+    @TempDir Path temporary;
+
+    private SSTableReader table(int number, byte[] value) throws Exception {
+        var builder = new SSTableBuilder(temporary.resolve("table-" + number), number, UUID.randomUUID(), 1);
+        builder.add(new InternalKey(new byte[]{1}, 10, (byte)1), value);
+        var metadata = builder.finish();
+        return SSTableReader.open(metadata.path(), metadata);
+    }
+
+    private InternalIterator merge(List<SSTableReader> readers) throws Exception {
+        var method = PersistentAetherDatabase.class.getDeclaredMethod("mergeCompactionReaders", List.class);
+        method.setAccessible(true);
+        return (InternalIterator) method.invoke(null, readers);
+    }
+
+    @Test void acceptsIdenticalDuplicatesAndRejectsConflictingValues() throws Exception {
+        try (var first = table(1, new byte[]{2}); var identical = table(2, new byte[]{2});
+             var conflict = table(3, new byte[]{3})) {
+            try (var iterator = merge(List.of(first, identical))) {
+                assertThat(iterator.next()).isTrue();
+                assertThat(iterator.current().value()).containsExactly((byte)2);
+                assertThat(iterator.next()).isFalse();
+            }
+            try (var iterator = merge(List.of(first, conflict))) {
+                assertThat(iterator.next()).isTrue();
+                assertThatThrownBy(iterator::next).isInstanceOf(IllegalStateException.class)
+                        .hasMessageContaining("different values");
+            }
+        }
+    }
+
+    @Test void visitorOwnsBytesAndProtectsItsSnapshot() {
+        Path path = temporary.resolve("database");
+        var configuration = new AetherConfiguration(Map.of("aether.storage.disk_pressure.enabled", "false",
+                "aether.security.profile", "development"));
+        try (AetherDatabase database = Aether.open(path, configuration)) {
+            database.put(new byte[]{1}, new byte[]{10});
+            database.put(new byte[]{2}, new byte[]{20});
+            var observed = new java.util.ArrayList<Byte>();
+            Aether.visitEntries(database, (key, value) -> {
+                observed.add(value[0]);
+                database.put(new byte[]{2}, new byte[]{30});
+                key[0] = 99;
+                value[0] = 99;
+            });
+            assertThat(observed).containsExactly((byte)10, (byte)20);
+            assertThat(database.get(new byte[]{2}).value()).containsExactly((byte)30);
+        }
+        try (AetherDatabase database = Aether.open(path, configuration)) {
+            assertThat(database.get(new byte[]{2}).value()).containsExactly((byte)30);
+        }
+    }
