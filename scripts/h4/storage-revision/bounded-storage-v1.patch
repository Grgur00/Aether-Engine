+package io.aetherdb.sstable;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import java.nio.file.Path;
+import java.util.Map;
+import java.util.UUID;
+import static org.assertj.core.api.Assertions.*;
+
+class H4BoundedBlockCacheTest {
+    @TempDir Path temporary;
+
+    @Test void verificationAndStreamingScanDoNotPopulateCacheAndEvictionReloads() throws Exception {
+        var builder = new SSTableBuilder(temporary.resolve("cache-table"), 1, UUID.randomUUID(), 1);
+        byte[] payload = new byte[128 * 1024];
+        for (int index = 0; index < 100; index++)
+            builder.add(new InternalKey(new byte[]{(byte)index}, 1, (byte)1), payload);
+        var metadata = builder.finish();
+        var bytesField = SSTableReader.class.getDeclaredField("cachedBytes");
+        bytesField.setAccessible(true);
+        var cacheField = SSTableReader.class.getDeclaredField("BLOCK_CACHE");
+        cacheField.setAccessible(true);
+        try (var reader = SSTableReader.open(metadata.path(), metadata)) {
+            long before = bytesField.getLong(null);
+            var stream = reader.streamingEntries();
+            int count = 0;
+            while (stream.hasNext()) { stream.next(); count++; }
+            assertThat(count).isEqualTo(100);
+            assertThat(bytesField.getLong(null)).isEqualTo(before);
+            var first = reader.lookup(new byte[]{0}, 1);
+            assertThat(reader.lookup(new byte[]{0}, 1)).isSameAs(first);
+            for (int index = 1; index < 100; index++) reader.lookup(new byte[]{(byte)index}, 1);
+            assertThat(bytesField.getLong(null)).isLessThanOrEqualTo(8L * 1024 * 1024);
+            var reloaded = reader.lookup(new byte[]{0}, 1);
+            assertThat(reloaded).isNotSameAs(first);
+            assertThat(((SSTableLookup.Found)reloaded).value()).containsExactly(payload);
+        }
+        assertThat(((Map<?, ?>)cacheField.get(null)).size()).isEqualTo(0);
+    }
+}
