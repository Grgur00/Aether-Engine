+package io.aetherdb.lsm.compaction;
+
+import io.aetherdb.lsm.iterator.InternalEntry;
+import io.aetherdb.lsm.iterator.InternalIterator;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+
+class H4StreamingRetentionTest {
+    @Test void doesNotConsumeWholeVersionGroupBeforeReturningFirstEntry() {
+        int[] consumed = {0};
+        var source = new InternalIterator() {
+            public boolean next() { return ++consumed[0] <= 100000; }
+            public InternalEntry current() {
+                return InternalEntry.value(new byte[]{1}, 100001L - consumed[0], new byte[]{2});
+            }
+            public void close() {}
+        };
+        try (var dropping = new CompactionDroppingIterator(source, 99999, key -> false)) {
+            assertThat(dropping.next()).isTrue();
+            assertThat(consumed[0]).isEqualTo(1);
+            assertThat(dropping.next()).isTrue();
+            assertThat(dropping.current().sequence()).isEqualTo(99999);
+            assertThat(dropping.next()).isFalse();
+            assertThat(dropping.droppedVersions()).isEqualTo(99998);
+        }
+    }
